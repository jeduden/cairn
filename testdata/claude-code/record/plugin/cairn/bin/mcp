#!/usr/bin/env python3
"""mcp: spike S4's stub of the Cairn MCP server.

Speaks MCP over stdio, offers one stub recall tool, and logs every message it
reads, with its own pid and what its process sees, to $REC_OUT/mcp/<pid>.jsonl.
A tool call names no run, only its tool-use id, so the server finds the run by
the transcript that holds that id, waiting up to two seconds for it. Each run
gets a fake run-seat key, minted and kept here, logged only to that file and
never returned to the harness. A key handed over at launch in the
environment, as CAIRN_S4_RUN_KEY, is logged the same way.
"""
import json
import os
import secrets
import sys
import time

OUT = os.path.join(os.environ.get("REC_OUT", "/tmp/cairn-s4"), "mcp")
os.makedirs(OUT, exist_ok=True)
LOG = open(os.path.join(OUT, f"{os.getpid()}.jsonl"), "a", buffering=1)
SEEN = ("CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ATTENDED",
        "CLAUDE_CODE_CHILD_SESSION", "AI_AGENT", "CLAUDECODE",
        "CLAUDE_PLUGIN_ROOT", "CLAUDE_PLUGIN_DATA",
        "CLAUDE_PROJECT_DIR", "CLAUDE_CODE_SESSION_ID", "TERM")
KEYS = {}


def log(kind, **fields):
    LOG.write(json.dumps({"t": time.time_ns(), "kind": kind, **fields}) + "\n")


def projects():
    cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(
        os.environ.get("HOME", "/"), ".claude")
    return os.path.join(cfg, "projects")


def holders(needle):
    """The transcripts under the projects tree that hold needle now."""
    found = []
    for root, _, files in os.walk(projects()):
        for name in files:
            if name.endswith(".jsonl"):
                path = os.path.join(root, name)
                with open(path, errors="replace") as f:
                    if needle in f.read():
                        found.append(path)
    return sorted(found)


def run_of(params):
    """The run whose transcript holds the call's tool-use id."""
    use = (params.get("_meta") or {}).get("claudecode/toolUseId")
    if not use:
        log("bind", tool_use_id=None, run="unnamed", waited_ms=0)
        return "unnamed"
    start = time.monotonic()
    while True:
        found = holders(use)
        waited = int((time.monotonic() - start) * 1000)
        if found or waited > 2000:
            break
        time.sleep(0.05)
    run = os.path.basename(found[0])[:-len(".jsonl")] if len(found) == 1 else "ambiguous"
    log("bind", tool_use_id=use, run=run, transcripts=found, waited_ms=waited)
    return run


def answer(msg):
    method, params = msg.get("method"), msg.get("params") or {}
    if method == "initialize":
        return {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "cairn-stub", "version": "0.0.0-s4"}}
    if method == "tools/list":
        return {"tools": [{
            "name": "event_search",
            "description": "Spike S4 stub of Cairn's recall search. Returns a fixed text.",
            "inputSchema": {"type": "object",
                            "properties": {"query": {"type": "string"}},
                            "required": ["query"]}}]}
    if method == "tools/call":
        run = run_of(params)
        if run not in KEYS:
            KEYS[run] = "S4-FAKE-KEY-" + secrets.token_hex(16)
            log("key", run=run, key=KEYS[run])
        return {"content": [{"type": "text", "text": "cairn-stub: no events"}]}
    if method == "ping":
        return {}
    return None


def main():
    log("start", pid=os.getpid(), ppid=os.getppid(), uid=os.getuid(),
        argv=sys.argv, cwd=os.getcwd(),
        env={k: os.environ.get(k, "<unset>") for k in SEEN},
        names=sorted(os.environ))
    if os.environ.get("CAIRN_S4_RUN_KEY"):
        log("key", run="launch", key=os.environ["CAIRN_S4_RUN_KEY"],
            channel="environment")
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            log("unparsable", line=line)
            continue
        log("in", msg=msg)
        if "id" not in msg:
            continue
        result = answer(msg)
        if result is None:
            reply = {"jsonrpc": "2.0", "id": msg["id"],
                     "error": {"code": -32601, "message": "method not found"}}
        else:
            reply = {"jsonrpc": "2.0", "id": msg["id"], "result": result}
        sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()
    log("eof")


main()
